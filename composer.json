{
    "name": "payloadshield/comphpps",
    "description": "Framework-neutral pluggable encryption handlers for PayloadShield (Laravel, CakePHP, etc.)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["crypto", "encryption", "payloadshield"],
    "homepage": "https://github.com/PayloadShield/ComPHPPS",
    "authors": [
        {
            "name": "Ganesh Kandu",
            "email": "kanduganesh@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-json": "*"
    },
    "suggest": {
        "ext-sodium": "Required for the hpke encryption handler (X25519 key agreement + ChaCha20-Poly1305 AEAD)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PayloadShield\\ComPHPPS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayloadShield\\ComPHPPS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
